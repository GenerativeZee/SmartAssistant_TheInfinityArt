# Copy to .env.local and fill in.
#
# LOCAL SUPABASE (after `npx supabase start`, use the values it prints):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by the numbering concurrency test (tests/numbering.test.ts).
# Local Supabase default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# HOSTED SUPABASE (Project Settings -> API):
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
